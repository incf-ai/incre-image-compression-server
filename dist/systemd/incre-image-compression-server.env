# incre-image-compression-server's settings; both services read this file. A flag on ExecStart wins over it.
# After a change: sudo systemctl restart incre-image-compression-server incre-image-compression-worker

# Where clients connect. Open this port to your LAN only: the token is sent in the clear.
#INCRE_COMPRESS_LISTEN=0.0.0.0:8790

# The token clients send as "Authorization: Bearer ...". install.sh made one here.
#INCRE_COMPRESS_TOKEN_FILE=/etc/incre-image-compression-server/token

# RAM for pictures waiting and results not yet fetched; full means 503 + Retry-After.
# Keep it under the serve unit's MemoryMax.
#INCRE_COMPRESS_MAX_HELD_MB=2048
#INCRE_COMPRESS_MAX_JOB_MB=64
#INCRE_COMPRESS_MAX_JOBS=10000
#INCRE_COMPRESS_RESULT_TTL_S=1800

# Encoder threads; every CPU by default. They only get CPU time nothing else wants, so all
# of them is usually right. Each needs up to a few hundred MB on big pictures.
#INCRE_COMPRESS_THREADS=0
